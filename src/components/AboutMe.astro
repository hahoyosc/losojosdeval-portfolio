---
import { Image } from "astro:assets";
import val from "../assets/aboutme/val.webp";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="border-t border-(--border) py-24 px-12" id="about-me">
  <div
    class="lg:max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-start"
  >
    <div data-reveal class="reveal">
      <p
        class="text-xs tracking-widest uppercase text-(--red) mb-10 flex items-center gap-3"
      >
        {t("about.eyebrow")}
        <span class="flex-1 max-w-14 h-0.5 bg-[#C84A2F]/35"></span>
      </p>
      <h2
        class="cormorant-garamond-normal text-6xl font-light text-(--cream) mb-8"
      >
        {t("about.heading.part1")}<br />{t("about.heading.part2")}<br /><em
          class="italic text-(--gold)">{t("about.heading.part3")}</em
        >
      </h2>
      <p class="text-sm text-(--muted) leading-6 mb-5 max-w-lg">
        {t("about.paragraph1")}
      </p>
      <p class="text-sm text-(--muted) leading-6 mb-5 max-w-lg">
        {t("about.paragraph2")}
      </p>
      <p class="text-sm text-(--muted) leading-6 mb-5 max-w-lg">
        {t("about.paragraph3")}
      </p>
    </div>
    <div
      data-reveal
      class="reveal pt-0 md:pt-14 flex justify-center items-center"
    >
      <div
        class="w-full max-w-sm md:max-w-md mx-auto md:mx-0 aspect-3/4 relative overflow-hidden rounded-2xl"
      >
        <Image
          src={val}
          alt="Val"
          width={800}
          height={1067}
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
