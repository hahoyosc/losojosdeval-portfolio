---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import WorkCarousel from "./WorkCarousel.astro";
import WorkVideoModal from "./WorkVideoModal.astro";

const work = await getCollection("works");

const categoryLabel: Record<string, string> = {
  photo: "Foto",
  video: "Video",
  design: "Diseño",
};

function shuffle<T>(items: T[]): T[] {
  const shuffled = [...items];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

const workWithShuffledImages = work.map((item) => ({
  item,
  shuffledImages: shuffle(item.data.images ?? []),
}));
---

<section class="pt-20 px-12 pb-24 border-t border-(--border)" id="work">
  <div class="lg:max-w-5xl mx-auto">
    <div
      data-reveal
      class="opacity-0 translate-y-8 transition-all duration-700 ease-out
     data-visible:opacity-100 data-visible:translate-y-0"
    >
      <div
        class="flex items-center mb-12 border border-(--border) rounded-s-sm overflow-hidden w-fit"
        role="group"
        aria-label="Filtrar por disciplina"
      >
        <button
          class="py-2.5 px-6 text-xs tracking-widest uppercase text-(--muted) bg-transparent
        border-none border-r border-r-(--border) last:border-r-0 cursor-pointer select-none
        transition-[background-color,color] duration-200 hover:bg-(--dim)
        hover:text-[#F0EAE0] data-selected:bg-(--red) data-selected:text-(--cream)"
          data-filter="video"
          data-selected>Video</button
        >
        <button
          class="py-2.5 px-6 text-xs tracking-widest uppercase text-(--muted) bg-transparent
        border-none border-r border-r-(--border) last:border-r-0 cursor-pointer select-none
        transition-[background-color,color] duration-200
        hover:bg-(--dim) hover:text-[#F0EAE0] data-selected:bg-(--red) data-selected:text-(--cream)"
          data-filter="photo">Fotografía</button
        >
        <button
          class="py-2.5 px-6 text-xs tracking-widest uppercase text-(--muted) bg-transparent
        border-none border-r border-r-(--border) last:border-r-0 cursor-pointer select-none
        transition-[background-color,color] duration-200
        hover:bg-(--dim)hover:text-[#F0EAE0] data-selected:bg-(--red) data-selected:text-(--cream)"
          data-filter="design">Diseño</button
        >
      </div>
    </div>
    <div
      data-reveal
      class="opacity-0 translate-y-8 transition-all duration-700 ease-out
      data-visible:opacity-100 data-visible:translate-y-0 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0.5"
      id="work-grid"
    >
      {
        workWithShuffledImages.map(({ item, shuffledImages }) => {
          const isVideo = item.data.category === "video";
          return (
            <button
              type="button"
              data-open-modal={`work-modal-${item.id}`}
              class="break-inside-avoid mb-0.5 relative overflow-hidden cursor-pointer block group text-left
              opacity-0 translate-y-4 transition-all duration-500 ease-out
              data-visible:opacity-100 data-visible:translate-y-0"
              data-cat={item.data.category}
            >
              <div class="block w-full">
                <div class="block w-full relative overflow-hidden aspect-3/4">
                  {isVideo
                    ? item.data.video?.thumbnail && (
                        <Image
                          src={item.data.video.thumbnail}
                          alt={item.data.title}
                          width={600}
                          height={800}
                          class="absolute inset-0 w-full h-full object-cover"
                        />
                      )
                    : shuffledImages[0] && (
                        <Image
                          src={shuffledImages[0].src}
                          alt={item.data.title}
                          width={600}
                          height={800}
                          class="absolute inset-0 w-full h-full object-cover"
                        />
                      )}
                  <div
                    class="absolute inset-0 bg-linear-to-t from-[#0e0c0a]/90 via-[#0e0c0a]/10 to-transparent sm:opacity-0
                    transition-opacity duration-500 ease-in-out flex flex-col justify-end py-6 px-5 group-hover:opacity-100"
                  >
                    <p class="cormorant-garamond-italic text-2xl font-normal italic text-(--cream) leading-none">
                      {item.data.title}
                    </p>
                    <p class="text-xs tracking-widest uppercase text-(--red) mt-2">
                      {item.data.subtitle} · {item.data.year}
                    </p>
                  </div>
                </div>
              </div>
            </button>
          );
        })
      }
    </div>
  </div>
</section>

{
  workWithShuffledImages.map(({ item, shuffledImages }) =>
    item.data.category === "video" ? (
      <WorkVideoModal item={item} />
    ) : (
      <WorkCarousel
        item={{ ...item, data: { ...item.data, images: shuffledImages } }}
      />
    ),
  )
}

<script>
  import { openModal } from "../scripts/modalTransitions";

  document
    .querySelectorAll<HTMLElement>("[data-open-modal]")
    .forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const modal = document.getElementById(
          trigger.dataset.openModal!,
        ) as HTMLDialogElement | null;
        if (!modal) return;

        openModal(modal);
      });
    });

  const filterBtns =
    document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("#work-grid [data-cat]");

  function applyFilter(filter: string) {
    items.forEach((item) => {
      const matches = filter === "all" || item.dataset.cat === filter;

      if (matches) {
        item.hidden = false;
        delete item.dataset.visible;
        void item.offsetWidth;
        requestAnimationFrame(() => {
          item.dataset.visible = "";
        });
      } else {
        delete item.dataset.visible;
        item.hidden = true;
      }
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => delete b.dataset.selected);
      btn.dataset.selected = "";
      applyFilter(btn.dataset.filter ?? "all");
    });
  });

  const initialBtn = document.querySelector<HTMLButtonElement>(
    "[data-filter][data-selected]",
  );
  if (initialBtn) applyFilter(initialBtn.dataset.filter ?? "all");
</script>
