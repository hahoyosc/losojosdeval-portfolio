---
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, localize } from "../i18n/utils";

interface Props {
  item: CollectionEntry<"works">;
}
const { item } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<dialog
  id={`work-modal-${item.id}`}
  class="hidden open:flex flex-col backdrop:bg-black/90 bg-transparent text-(--cream) w-screen h-screen max-w-none m-0 overflow-visible"
>
  <button
    data-close
    aria-label="Close"
    class="absolute top-10 right-5 z-30 text-2xl text-(--cream) hover:text-(--red) cursor-pointer"
  >
    ×
  </button>

  <div
    class="relative w-full flex-1 min-h-0 flex items-center justify-center overflow-hidden pt-10"
    data-video-wrap
  >
    {
      item.data.video && (
        <video
          src={item.data.video.src}
          poster={item.data.video.thumbnail.src}
          controls
          playsinline
          preload="none"
          class={`rounded-xl shadow-2xl ${item.data.video.orientation === "portrait" ? "max-h-11/12 w-fit" : "max-w-11/12 h-fit"}`}
          data-video
        />
      )
    }
  </div>

  <div
    class="relative mx-6 sm:mx-10 mb-18 shrink-0 bg-(--carbon)/95 backdrop-blur-md border border-(--border) rounded-sm p-6 z-20 overflow-y-auto max-h-48"
  >
    <h3 class="cormorant-garamond-normal text-3xl font-light mb-1">
      {localize(item.data.title, lang)}
    </h3>
    <p class="text-xs tracking-widest uppercase text-(--red) mb-4">
      {localize(item.data.subtitle, lang)} · {item.data.year}
    </p>
    <div class="text-sm text-(--muted) leading-7">
      {
        item.data.description && (
          <p set:html={localize(item.data.description, lang)} />
        )
      }
    </div>
  </div>
</dialog>

<script>
  import { wireDialogClose } from "../scripts/modalTransitions";

  document
    .querySelectorAll<HTMLDialogElement>("dialog[id^='work-modal-']")
    .forEach((dialog) => {
      const video = dialog.querySelector<HTMLVideoElement>("[data-video]");
      const wrap = dialog.querySelector<HTMLElement>("[data-video-wrap]");

      (dialog as HTMLDialogElement & { onModalOpen?: () => void }).onModalOpen =
        () => {
          if (!video) return;
          video.muted = true;
          video
            .play()
            .then(() => {
              video.muted = false;
            })
            .catch(() => {});
        };

      const close = () => {
        video?.pause();
        if (video) video.currentTime = 0;
      };

      const closeFn = wireDialogClose(dialog);
      wrap?.addEventListener("click", (e) => {
        if (e.target === wrap) closeFn();
      });

      dialog.addEventListener("close", close);
    });
</script>
